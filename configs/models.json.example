{
  "providers": {
    "<PROVIDER>": {
      "baseUrl": "https://<CAMPUS_AI_HOST>/open/api/v1",
      "api": "openai-completions",
      "apiKey": "<MODEL_API_KEY>",
      "models": [
        { "id": "<MODEL_ID>", "contextWindow": 256000, "reasoning": true, "input": ["text", "image"] }
      ]
    }
  }
}
